      "entry": "route-resolution",
      "question": "nova/equilibrium/support_read.py read, read_batch, read_and_book and bank_program carry kernels in the device trace and zero body lines on both measured routes. Which topology read does each route run?",
      "findings": [
        {
          "module": "nova/equilibrium/forward.py",
          "required": "read_qualification",
          "required_calls": 1,
          "forbidden": "read_at_stationary_points",
          "forbidden_calls": 0,
          "passes": true
        },
        {
          "module": "nova/equilibrium/forward_operator.py",
          "required": "read_qualification",
          "required_calls": 2,
          "forbidden": "read_at_stationary_points",
          "forbidden_calls": 0,
          "passes": true
        },
        {
          "module": "nova/equilibrium/support_read.py",
          "required": "read_at_stationary_points",
          "required_calls": 2,
          "forbidden": "read_qualification",
          "forbidden_calls": 0,
          "passes": true
        }
      ],
      "conclusion": "both measured routes read topology through Topology.read_qualification, the flux-map null census. The supplied-stationary-point read is reached only from support_read.py, whose callers execute zero body lines on these routes",
      "agrees": true
    },
